# Skopiuj ten plik jako .env i uzupełnij. NIGDY nie wysyłaj nikomu pliku .env.

# Hasło do panelu
ADMIN_PASSWORD=

# Anthropic (ocena AI) – klucz z console.anthropic.com
ANTHROPIC_API_KEY=
# Model AI: claude-opus-5-5 (najlepszy, domyślny), claude-sonnet-5-5 (tańszy), claude-haiku-5-5 (najtańszy)
AI_MODEL=claude-opus-5-5
# Staranność oceny: low | medium | high
AI_EFFORT=medium

# Facebook – uzupełnimy razem przy podłączaniu aplikacji Meta
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
FB_GRAPH_VERSION=v24.0

# Strona spottedkoszalin.pl – zakładka „Praca” (ogłoszenia z formularza)
SITE_API_URL=https://spottedkoszalin.pl
# ten sam klucz co PANEL_API_TOKEN w pliku .env strony
SITE_API_TOKEN=
# tylko dopóki strona jest pod hasłem katalogu na Hostido: login:hasło
SITE_BASIC_AUTH=
